{
  "mcpServers": {
    "time": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "mcp-server-time",
        "--local-timezone=America/Chicago"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-server-fetch"]
    },
    "ddg-search": {
      "command": "uvx",
      "args": ["duckduckgo-mcp-server"]
    }
  }
}
